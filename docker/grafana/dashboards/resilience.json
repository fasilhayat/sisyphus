{
  "title": "Oasis Resilience",
  "uid": "oasis-resilience",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Circuit Breaker State",
      "description": "Current state per operation: 0 = Closed (green), 1 = Half-Open (yellow), 2 = Open (red)",
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 6 },
      "datasource": { "uid": "prometheus", "type": "prometheus" },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "Closed",    "color": "green"  } } },
            { "type": "value", "options": { "1": { "text": "Half-Open", "color": "yellow" } } },
            { "type": "value", "options": { "2": { "text": "Open",      "color": "red"    } } }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green",  "value": null },
              { "color": "yellow", "value": 1    },
              { "color": "red",    "value": 2    }
            ]
          },
          "color": { "mode": "thresholds" }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "resilience_circuit_state",
          "legendFormat": "{{operation}}",
          "datasource": { "uid": "prometheus", "type": "prometheus" }
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Circuit Breaker Transitions",
      "description": "Rate of state transitions per second, labelled by target state.",
      "gridPos": { "x": 0, "y": 6, "w": 12, "h": 8 },
      "datasource": { "uid": "prometheus", "type": "prometheus" },
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "fieldConfig": {
        "defaults": { "custom": { "lineWidth": 2 } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "Open"     }, "properties": [{ "id": "color", "value": { "fixedColor": "red",    "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "HalfOpen" }, "properties": [{ "id": "color", "value": { "fixedColor": "yellow", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "Closed"   }, "properties": [{ "id": "color", "value": { "fixedColor": "green",  "mode": "fixed" } }] }
        ]
      },
      "targets": [
        {
          "expr": "rate(resilience_circuit_transitions_total[1m])",
          "legendFormat": "{{to_state}} — {{operation}}",
          "datasource": { "uid": "prometheus", "type": "prometheus" }
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Retry Attempts",
      "description": "Rate of retry attempts per second per operation.",
      "gridPos": { "x": 12, "y": 6, "w": 12, "h": 8 },
      "datasource": { "uid": "prometheus", "type": "prometheus" },
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "fieldConfig": {
        "defaults": { "custom": { "lineWidth": 2 }, "color": { "mode": "palette-classic" } },
        "overrides": []
      },
      "targets": [
        {
          "expr": "rate(resilience_retry_attempts_total[1m])",
          "legendFormat": "attempts — {{operation}}",
          "datasource": { "uid": "prometheus", "type": "prometheus" }
        },
        {
          "expr": "rate(resilience_retry_failures_total[1m])",
          "legendFormat": "failures — {{operation}}",
          "datasource": { "uid": "prometheus", "type": "prometheus" }
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Cumulative Retry Attempts",
      "description": "Running total of attempts and failures since the demo started.",
      "gridPos": { "x": 0, "y": 14, "w": 24, "h": 7 },
      "datasource": { "uid": "prometheus", "type": "prometheus" },
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "table", "placement": "right", "calcs": ["sum"] }
      },
      "fieldConfig": {
        "defaults": { "custom": { "lineWidth": 1, "fillOpacity": 10 }, "color": { "mode": "palette-classic" } },
        "overrides": []
      },
      "targets": [
        {
          "expr": "resilience_retry_attempts_total",
          "legendFormat": "attempts — {{operation}}",
          "datasource": { "uid": "prometheus", "type": "prometheus" }
        },
        {
          "expr": "resilience_retry_failures_total",
          "legendFormat": "failures — {{operation}}",
          "datasource": { "uid": "prometheus", "type": "prometheus" }
        }
      ]
    }
  ]
}
